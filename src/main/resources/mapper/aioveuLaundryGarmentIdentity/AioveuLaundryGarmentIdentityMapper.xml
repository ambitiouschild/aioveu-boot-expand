<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aioveu.boot.aioveuLaundryGarmentIdentity.mapper.AioveuLaundryGarmentIdentityMapper">

    <!-- 获取衣物唯一编码分页列表 -->
    <select id="getAioveuLaundryGarmentIdentityPage" resultType="com.aioveu.boot.aioveuLaundryGarmentIdentity.model.vo.AioveuLaundryGarmentIdentityVO">
        SELECT
                id,
                garment_code,
                garment_order_detail_id,
                qr_code_path,
                status,
                create_time,
                update_time
        FROM
            aioveu_laundry_garment_identity
        <where>
            <if test="queryParams.id != null">
                AND id = #{queryParams.id}
            </if>
            <if test="queryParams.garmentCode != null and queryParams.garmentCode != ''">
                AND garment_code = #{queryParams.garmentCode}
            </if>
            <if test="queryParams.garmentOrderDetailId != null">
                AND garment_order_detail_id = #{queryParams.garmentOrderDetailId}
            </if>
            <if test="queryParams.status != null">
                AND status = #{queryParams.status}
            </if>
        </where>
    </select>

</mapper>
