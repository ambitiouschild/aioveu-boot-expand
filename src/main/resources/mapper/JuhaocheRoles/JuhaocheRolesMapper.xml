<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aioveu.boot.JuhaocheRoles.mapper.JuhaocheRolesMapper">

    <!-- 获取角色分页列表 -->
    <select id="getJuhaocheRolesPage" resultType="com.aioveu.boot.JuhaocheRoles.model.vo.JuhaocheRolesVO">
        SELECT
                id,
                role_id,
                name,
                code,
                role_type,
                description,
                merchant_level,
                is_enable,
                create_time,
                create_user,
                update_time,
                update_user,
                is_del
        FROM
            juhaoche_roles
        <where>
            <if test="queryParams.name != null and queryParams.name != ''">
                AND name = #{queryParams.name}
            </if>
            <if test="queryParams.code != null and queryParams.code != ''">
                AND code = #{queryParams.code}
            </if>
            <if test="queryParams.roleType != null and queryParams.roleType != ''">
                AND role_type = #{queryParams.roleType}
            </if>
            <if test="queryParams.description != null and queryParams.description != ''">
                AND description = #{queryParams.description}
            </if>
        </where>
    </select>

</mapper>
